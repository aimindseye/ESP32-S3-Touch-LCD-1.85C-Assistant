#include <ctype.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
static const char *radio_stream_format_label(const char *url) {
    if (url != NULL && strncmp(url, "https://", 8) == 0) {
        return "HTTPS_MP3";
    }
    return "HTTP_MP3";
}
static void st77916_radio_https_tls_boot_marker(void) {
    static int printed = 0;
    if (!printed) {
        printed = 1;
        printf("radio-r36-r17: https_tls=CRT_BUNDLE verification=ESP_CRT_BUNDLE http_unchanged=YES audio=PCM5101_I2S\n");
    }
}



#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "esp_err.h"
#include "esp_http_client.h"
#include "esp_crt_bundle.h"
#include "mp3dec.h"

extern bool st77916_audio_pcm_init(uint32_t sample_rate, uint16_t bits_per_sample, uint16_t channels);
extern int32_t st77916_audio_pcm_write(const uint8_t *data, uint32_t len, uint32_t timeout_ms);
extern void st77916_audio_pcm_stop(void);

#define RADIO_INPUT_BYTES 98304
#define RADIO_R20_LOW_WATER_BYTES 8192
#define RADIO_R20_PREFILL_TARGET_BYTES 32768
#define RADIO_R20_MAX_REFILL_SPINS 2
#define RADIO_SMALL_RESPONSE_BYTES 4096
#define RADIO_RESOLVED_URL_BYTES 512
#define RADIO_REFILL_CHUNK 4096
#define RADIO_HELIX_OUT_SAMPLES (MAX_NCHAN * MAX_NGRAN * MAX_NSAMP)
#define RADIO_MAX_DECODE_ERRORS 96

enum {
    RADIO_STATUS_IDLE = 0,
    RADIO_STATUS_CONNECTING = 1,
    RADIO_STATUS_BUFFERING = 2,
    RADIO_STATUS_PLAYING = 3,
    RADIO_STATUS_STOPPING = 4,
    RADIO_STATUS_STOPPED = 5,
    RADIO_STATUS_ERROR = 6,
};

static volatile bool s_radio_stop_requested = false;
static volatile uint32_t s_radio_volume_percent = 60;
static volatile uint32_t s_radio_elapsed_seconds = 0;
static volatile uint32_t s_radio_buffered_bytes = 0;
static volatile uint32_t s_radio_status = RADIO_STATUS_IDLE;

void st77916_radio_http_mp3_set_volume(uint32_t volume_percent) {
    s_radio_volume_percent = volume_percent > 100 ? 100 : volume_percent;
}

uint32_t st77916_radio_http_mp3_elapsed_seconds(void) {
    return s_radio_elapsed_seconds;
}

uint32_t st77916_radio_http_mp3_buffered_bytes(void) {
    return s_radio_buffered_bytes;
}

uint32_t st77916_radio_http_mp3_status_code(void) {
    return s_radio_status;
}

void st77916_radio_http_mp3_stop_request(void) {
    s_radio_stop_requested = true;
    s_radio_status = RADIO_STATUS_STOPPING;
    printf("radio-r36: stop_request=DEFERRED_TO_STREAM_THREAD i2s_stop_owner=RADIO_THREAD audio=PCM5101_I2S\n");
}

/* v0.1.36-r19: HTTPS playlist/small-response guard.
 *
 * Many HTTPS radio catalog URLs are not direct MP3 streams. They return a tiny
 * M3U/PLS/player response, for example 117 or 431 bytes. The old stream loop
 * waited for a 64KB MP3 buffer and could spin until the watchdog fired.
 */

static const char *radio_r20_url_kind(const char *url) {
    if (url == NULL) {
        return "UNKNOWN";
    }
    if (strstr(url, "/player/") != NULL) {
        return "PLAYER_PAGE";
    }
    if (strstr(url, ".m3u8") != NULL || strstr(url, "hlsp") != NULL || strstr(url, "hls") != NULL) {
        return "HLS_PLAYLIST";
    }
    if (strstr(url, ".m3u") != NULL || strstr(url, "tunein-station") != NULL) {
        return "M3U_PLAYLIST";
    }
    if (strncmp(url, "https://", 8) == 0) {
        return "HTTPS_DIRECT_CANDIDATE";
    }
    if (strncmp(url, "http://", 7) == 0) {
        return "HTTP_DIRECT_CANDIDATE";
    }
    return "UNKNOWN";
}

static void radio_r20_yield(void) {
    vTaskDelay(pdMS_TO_TICKS(1));
}

/* v0.1.36-r22: forward declaration required because r20 helpers call refill_http() before its full definition. */
static bool refill_http(esp_http_client_handle_t client,
                        unsigned char *input,
                        unsigned char **read_ptr,
                        int *bytes_left);

static bool radio_r20_refill_to_low_water(esp_http_client_handle_t client,
                                          unsigned char *input,
                                          unsigned char **read_ptr,
                                          int *bytes_left) {
    if (client == NULL || input == NULL || read_ptr == NULL || bytes_left == NULL) {
        return false;
    }

    int spins = 0;
    while (!s_radio_stop_requested &&
           *bytes_left < RADIO_R20_LOW_WATER_BYTES &&
           spins < RADIO_R20_MAX_REFILL_SPINS) {
        if (!refill_http(client, input, read_ptr, bytes_left)) {
            return false;
        }
        spins++;
        radio_r20_yield();
    }

    printf("radio-r36-r23: status=REFILL_PACED buffered=%d low_water=%d spins=%d audio=PCM5101_I2S\n",
           *bytes_left,
           RADIO_R20_LOW_WATER_BYTES,
           spins);
    radio_r20_yield();
    return true;
}

int32_t st77916_radio_http_mp3_play(const char *url, const char *station_name, uint32_t volume_percent);

static volatile int s_radio_r19_resolve_depth = 0;

static bool radio_r19_url_delim(char c) {
    return c == '\0' || c == '\r' || c == '\n' || c == '"' || c == '\'' ||
           c == '<' || c == '>' || c == ')' || c == '(' ||
           isspace((unsigned char)c);
}

static bool radio_r19_copy_url_at(const char *p, char *out, size_t out_len, const char *original_url) {
    if (p == NULL || out == NULL || out_len < 16) {
        return false;
    }

    size_t n = 0;
    while (p[n] != '\0' && !radio_r19_url_delim(p[n]) && n + 1 < out_len) {
        out[n] = p[n];
        n++;
    }
    while (n > 0 && (out[n - 1] == ',' || out[n - 1] == ';' || out[n - 1] == ']')) {
        n--;
    }
    out[n] = '\0';

    if (n < 10) {
        return false;
    }
    if (original_url != NULL && strcmp(out, original_url) == 0) {
        return false;
    }
    return strncmp(out, "http://", 7) == 0 || strncmp(out, "https://", 8) == 0;
}

static bool radio_r19_extract_first_url(const char *body, char *out, size_t out_len, const char *original_url) {
    if (body == NULL || out == NULL) {
        return false;
    }

    const char *p = body;
    while ((p = strstr(p, "http://")) != NULL) {
        if (radio_r19_copy_url_at(p, out, out_len, original_url)) {
            return true;
        }
        p += 7;
    }

    p = body;
    while ((p = strstr(p, "https://")) != NULL) {
        if (radio_r19_copy_url_at(p, out, out_len, original_url)) {
            return true;
        }
        p += 8;
    }

    return false;
}

static bool radio_r19_looks_like_mp3(const unsigned char *buf, int len) {
    if (buf == NULL || len < 3) {
        return false;
    }

    if (len >= 3 && buf[0] == 'I' && buf[1] == 'D' && buf[2] == '3') {
        return true;
    }

    int scan = len < 512 ? len - 1 : 511;
    for (int i = 0; i < scan; i++) {
        if (buf[i] == 0xFF && (buf[i + 1] & 0xE0) == 0xE0) {
            return true;
        }
    }

    return false;
}

static int32_t radio_r19_handle_small_response(esp_http_client_handle_t client,
                                               const char *url,
                                               const char *station_name,
                                               uint32_t volume_percent,
                                               int content_length,
                                               int status_code,
                                               int *handled) {
    *handled = 0;

    if (content_length <= 0 || content_length > RADIO_SMALL_RESPONSE_BYTES || client == NULL) {
        return 0;
    }

    *handled = 1;

    char body[RADIO_SMALL_RESPONSE_BYTES + 1];
    int total = 0;
    while (total < content_length && total < RADIO_SMALL_RESPONSE_BYTES && !s_radio_stop_requested) {
        int want = content_length - total;
        if (want > 512) {
            want = 512;
        }
        int n = esp_http_client_read(client, body + total, want);
        if (n <= 0) {
            break;
        }
        total += n;
    }
    body[total] = '\0';

    if (radio_r19_looks_like_mp3((const unsigned char *)body, total)) {
        printf("radio-r36-r19: status=SMALL_MP3_RESPONSE station=%s bytes=%d action=FALL_THROUGH_TO_DECODER audio=PCM5101_I2S\n",
               station_name,
               total);
        return 0;
    }

    char resolved[RADIO_RESOLVED_URL_BYTES];
    if (radio_r19_extract_first_url(body, resolved, sizeof(resolved), url)) {
        printf("radio-r36-r19: status=PLAYLIST_RESOLVED station=%s status_code=%d bytes=%d url=%s audio=PCM5101_I2S\n",
               station_name,
               status_code,
               total,
               resolved);
        esp_http_client_close(client);
        esp_http_client_cleanup(client);

        if (s_radio_r19_resolve_depth >= 1) {
            printf("radio-r36-r19: status=PLAYLIST_RECURSION_BLOCKED station=%s audio=PCM5101_I2S\n", station_name);
            return -18;
        }

        s_radio_r19_resolve_depth++;
        int32_t code = st77916_radio_http_mp3_play(resolved, station_name, volume_percent);
        s_radio_r19_resolve_depth--;
        return code;
    }

    printf("radio-r36-r20: status=UNSUPPORTED_URL_KIND station=%s kind=%s status_code=%d bytes=%d content_length=%d action=STOP_NO_DECODE audio=PCM5101_I2S\n",
           station_name,
           radio_r20_url_kind(url),
           status_code,
           total,
           content_length);
    esp_http_client_close(client);
    esp_http_client_cleanup(client);
    return -19;
}


static void scale_pcm16(short *samples, int sample_count, uint32_t volume_percent) {
    int32_t volume = (int32_t)(volume_percent > 100 ? 100 : volume_percent);
    for (int i = 0; i < sample_count; i++) {
        int32_t scaled = ((int32_t)samples[i] * volume) / 100;
        if (scaled > 32767) {
            scaled = 32767;
        } else if (scaled < -32768) {
            scaled = -32768;
        }
        samples[i] = (short)scaled;
    }
}

static bool compact_input(unsigned char *input, unsigned char **read_ptr, int *bytes_left) {
    if (*read_ptr != input && *bytes_left > 0) {
        memmove(input, *read_ptr, (size_t)*bytes_left);
    }
    *read_ptr = input;
    return true;
}

static bool refill_http(esp_http_client_handle_t client,
                        unsigned char *input,
                        unsigned char **read_ptr,
                        int *bytes_left) {
    compact_input(input, read_ptr, bytes_left);

    while (*bytes_left < (RADIO_INPUT_BYTES - RADIO_REFILL_CHUNK) && !s_radio_stop_requested) {
        int space = RADIO_INPUT_BYTES - *bytes_left;
        if (space <= 0) {
            break;
        }
        int want = space > RADIO_REFILL_CHUNK ? RADIO_REFILL_CHUNK : space;
        int n = esp_http_client_read(client, (char *)(input + *bytes_left), want);
        if (n > 0) {
            *bytes_left += n;
            s_radio_buffered_bytes = (uint32_t)*bytes_left;
            if (*bytes_left >= 4096) {
                return true;
            }
            continue;
        }
        if (n == 0) {
            return *bytes_left > 0;
        }
        return false;
    }

    s_radio_buffered_bytes = (uint32_t)*bytes_left;
    return *bytes_left > 0;
}

int32_t st77916_radio_http_mp3_play(const char *url, const char *station_name, uint32_t volume_percent) {
    printf("radio-r36-r23: stream_pacing=LOW_LATENCY low_water=%d max_refill_spins=%d refill_chunk=%d input_bytes=%d audio=PCM5101_I2S\n",
           RADIO_R20_LOW_WATER_BYTES,
           RADIO_R20_MAX_REFILL_SPINS,
           RADIO_REFILL_CHUNK,
           RADIO_INPUT_BYTES);

    printf("radio-r36-r20: url_kind=%s url=%s stream_tuning=input_bytes=%d refill_chunk=%d low_water=%d audio=PCM5101_I2S\n",
           radio_r20_url_kind(url),
           url != NULL ? url : "(null)",
           RADIO_INPUT_BYTES,
           RADIO_REFILL_CHUNK,
           RADIO_R20_LOW_WATER_BYTES);

    if (url == NULL || station_name == NULL) {
        return -10;
    }

    s_radio_stop_requested = false;
    s_radio_elapsed_seconds = 0;
    s_radio_buffered_bytes = 0;
    s_radio_status = RADIO_STATUS_CONNECTING;
    st77916_radio_http_mp3_set_volume(volume_percent);

    printf("radio-r36-r15: action=CONNECT station=%s url=%s format=%s audio=PCM5101_I2S\n", station_name, url, radio_stream_format_label(url));

    esp_http_client_config_t config = {
        .url = url,
        .crt_bundle_attach = esp_crt_bundle_attach,
        .skip_cert_common_name_check = false,
        .timeout_ms = 12000,
        .buffer_size = 4096,
        .buffer_size_tx = 1024,
    };

        config.crt_bundle_attach = esp_crt_bundle_attach;
    config.skip_cert_common_name_check = false;
esp_http_client_handle_t client = esp_http_client_init(&config);
    if (client == NULL) {
        s_radio_status = RADIO_STATUS_ERROR;
        printf("radio-r36: status=HTTP_CLIENT_INIT_FAILED station=%s audio=PCM5101_I2S\n", station_name);
        return -11;
    }

    esp_http_client_set_header(client, "Icy-MetaData", "0");
    esp_http_client_set_header(client, "Accept", "audio/mpeg,audio/*,*/*");
    esp_http_client_set_header(client, "Connection", "keep-alive");
    esp_err_t err = esp_http_client_open(client, 0);
    if (err != ESP_OK) {
        s_radio_status = RADIO_STATUS_ERROR;
        printf("radio-r36-r17: status=HTTP_OPEN_FAILED station=%s err=%d https_tls=CRT_BUNDLE note=OPEN_FAILED audio=PCM5101_I2S\n", station_name, (int)err);
        esp_http_client_cleanup(client);
        return -12;
    }

    int content_length = esp_http_client_fetch_headers(client);
    int status_code = esp_http_client_get_status_code(client);
    printf("radio-r36-r15: status=%s station=%s http_status=%d content_length=%d audio=PCM5101_I2S\n",
           strncmp(url, "https://", 8) == 0 ? "HTTPS_CONNECTED" : "HTTP_CONNECTED",
           station_name,
           status_code,
           content_length);

    
    int radio_r19_small_response_handled = 0;
    int32_t radio_r19_small_response_code = radio_r19_handle_small_response(
        client, url, station_name, volume_percent, content_length, status_code, &radio_r19_small_response_handled);
    if (radio_r19_small_response_handled) {
        return radio_r19_small_response_code;
    }
HMP3Decoder decoder = MP3InitDecoder();
    if (decoder == NULL) {
        s_radio_status = RADIO_STATUS_ERROR;
        esp_http_client_close(client);
        esp_http_client_cleanup(client);
        printf("radio-r36: status=ALLOC_DECODER_FAILED station=%s audio=PCM5101_I2S\n", station_name);
        return -13;
    }

    unsigned char *input = (unsigned char *)malloc(RADIO_INPUT_BYTES);
    short *output = (short *)malloc(sizeof(short) * RADIO_HELIX_OUT_SAMPLES);
    if (input == NULL || output == NULL) {
        s_radio_status = RADIO_STATUS_ERROR;
        if (input != NULL) free(input);
        if (output != NULL) free(output);
        MP3FreeDecoder(decoder);
        esp_http_client_close(client);
        esp_http_client_cleanup(client);
        printf("radio-r36: status=ALLOC_BUFFER_FAILED station=%s input=%u output_samples=%u audio=PCM5101_I2S\n",
               station_name,
               (unsigned)RADIO_INPUT_BYTES,
               (unsigned)RADIO_HELIX_OUT_SAMPLES);
        return -14;
    }

    unsigned char *read_ptr = input;
    int bytes_left = 0;
    bool pcm_started = false;
    bool first_write = false;
    int current_sample_rate = 0;
    int current_channels = 0;
    int decode_errors = 0;
    int frame_count = 0;
    uint64_t decoded_pcm_frames = 0;

    s_radio_status = RADIO_STATUS_BUFFERING;
    printf("radio-r36: status=BUFFERING station=%s buffer_target=%u audio=PCM5101_I2S\n",
           station_name,
           (unsigned)RADIO_INPUT_BYTES);

    while (!s_radio_stop_requested) {
        if (bytes_left < RADIO_R20_LOW_WATER_BYTES) {
            if (!radio_r20_refill_to_low_water(client, input, &read_ptr, &bytes_left)) {
                printf("radio-r36-r20: status=REFILL_STARVED station=%s buffered=%d action=END_STREAM audio=PCM5101_I2S\n",
                       station_name,
                       bytes_left);
                break;
            }
        }

        if (bytes_left < 4096) {
            if (!refill_http(client, input, &read_ptr, &bytes_left)) {
                break;
            }
        }

        int sync_offset = MP3FindSyncWord(read_ptr, bytes_left);
        if (sync_offset < 0) {
            if (content_length > 0 && content_length <= RADIO_SMALL_RESPONSE_BYTES && bytes_left < 4096) {
                printf("radio-r36-r19: status=NO_MP3_SYNC_SMALL_RESPONSE station=%s bytes=%d content_length=%d action=STOP_NO_WDT audio=PCM5101_I2S\n",
                       station_name,
                       bytes_left,
                       content_length);
                break;
            }
            if (bytes_left > 3) {
                memmove(input, read_ptr + bytes_left - 3, 3);
                read_ptr = input;
                bytes_left = 3;
            } else {
                compact_input(input, &read_ptr, &bytes_left);
            }
            if (!refill_http(client, input, &read_ptr, &bytes_left)) {
                break;
            }
            continue;
        }

        read_ptr += sync_offset;
        bytes_left -= sync_offset;

        unsigned char *decode_ptr = read_ptr;
        int decode_left = bytes_left;
        int dec = MP3Decode(decoder, &decode_ptr, &decode_left, output, 0);
        int consumed = bytes_left - decode_left;

        if (consumed > 0) {
            read_ptr = decode_ptr;
            bytes_left = decode_left;
        } else if (bytes_left > 0) {
            read_ptr += 1;
            bytes_left -= 1;
        }
        s_radio_buffered_bytes = (uint32_t)bytes_left;

        if (dec == ERR_MP3_MAINDATA_UNDERFLOW || dec == ERR_MP3_INDATA_UNDERFLOW) {
            if (!refill_http(client, input, &read_ptr, &bytes_left)) {
                break;
            }
            continue;
        }

        if (dec != ERR_MP3_NONE) {
            decode_errors++;
            if (decode_errors > RADIO_MAX_DECODE_ERRORS) {
                radio_r20_yield();
            printf("radio-r36-r20: status=DECODE_YIELD_GUARD station=%s audio=PCM5101_I2S\n", station_name);
            printf("radio-r36: status=DECODE_ERROR station=%s err=%d errors=%d audio=PCM5101_I2S\n",
                       station_name,
                       dec,
                       decode_errors);
                break;
            }
            continue;
        }

        MP3FrameInfo info;
        memset(&info, 0, sizeof(info));
        MP3GetLastFrameInfo(decoder, &info);

        if (info.samprate < 8000 || info.samprate > 96000 || info.nChans < 1 || info.nChans > 2 || info.bitsPerSample != 16 || info.outputSamps <= 0) {
            printf("radio-r36: status=UNSUPPORTED_FRAME station=%s sample_rate=%d channels=%d bits=%d output_samps=%d audio=PCM5101_I2S\n",
                   station_name,
                   info.samprate,
                   info.nChans,
                   info.bitsPerSample,
                   info.outputSamps);
            break;
        }

        if (!pcm_started || current_sample_rate != info.samprate || current_channels != info.nChans) {
            if (pcm_started) {
                st77916_audio_pcm_stop();
            }
            if (!st77916_audio_pcm_init((uint32_t)info.samprate, 16, (uint16_t)info.nChans)) {
                printf("radio-r36: status=PCM_INIT_FAILED station=%s sample_rate=%d channels=%d audio=PCM5101_I2S\n",
                       station_name,
                       info.samprate,
                       info.nChans);
                break;
            }
            pcm_started = true;
            current_sample_rate = info.samprate;
            current_channels = info.nChans;
            s_radio_status = RADIO_STATUS_PLAYING;
            printf("radio-r36: status=PLAYING station=%s decoder=HELIX_FIXED_POINT sample_rate=%d channels=%d bitrate=%d audio=PCM5101_I2S\n",
                   station_name,
                   info.samprate,
                   info.nChans,
                   info.bitrate);
        }

        scale_pcm16(output, info.outputSamps, s_radio_volume_percent);
        int32_t written = st77916_audio_pcm_write((const uint8_t *)output, (uint32_t)(info.outputSamps * (int)sizeof(short)), 250);
        if (written <= 0) {
            printf("radio-r36: status=WRITE_FAILED station=%s err=%d audio=PCM5101_I2S\n", station_name, (int)written);
            break;
        }

        if (info.nChans > 0 && info.samprate > 0) {
            decoded_pcm_frames += (uint64_t)(info.outputSamps / info.nChans);
            s_radio_elapsed_seconds = (uint32_t)(decoded_pcm_frames / (uint64_t)info.samprate);
        }

        frame_count++;
        if (!first_write) {
            first_write = true;
            printf("radio-r36: status=FIRST_WRITE_OK station=%s bytes=%d sample_rate=%d channels=%d audio=PCM5101_I2S\n",
                   station_name,
                   (int)written,
                   info.samprate,
                   info.nChans);
        }

        if ((frame_count % 150) == 0) {
            printf("radio-r36: status=PROGRESS station=%s frames=%d elapsed_s=%u buffered=%u volume=%u audio=PCM5101_I2S\n",
                   station_name,
                   frame_count,
                   (unsigned)s_radio_elapsed_seconds,
                   (unsigned)s_radio_buffered_bytes,
                   (unsigned)s_radio_volume_percent);
        }
    }

    if (pcm_started) {
        st77916_audio_pcm_stop();
    }

    free(output);
    free(input);
    MP3FreeDecoder(decoder);
    esp_http_client_close(client);
    esp_http_client_cleanup(client);

    int stopped = s_radio_stop_requested ? 1 : 0;
    s_radio_stop_requested = false;
    s_radio_status = RADIO_STATUS_STOPPED;
    printf("radio-r36: status=%s station=%s frames=%d first_write=%s audio=PCM5101_I2S\n",
           stopped ? "STOPPED" : "ENDED_OR_ERROR",
           station_name,
           frame_count,
           first_write ? "YES" : "NO");

    return stopped ? 1 : 0;
}
