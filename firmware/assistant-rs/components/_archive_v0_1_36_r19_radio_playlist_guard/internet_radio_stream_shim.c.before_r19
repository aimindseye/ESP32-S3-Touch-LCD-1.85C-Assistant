#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
static const char *radio_stream_format_label(const char *url) {
    if (url != NULL && strncmp(url, "https://", 8) == 0) {
        return "HTTPS_MP3";
    }
    return "HTTP_MP3";
}
static void st77916_radio_https_tls_boot_marker(void) {
    static int printed = 0;
    if (!printed) {
        printed = 1;
        printf("radio-r36-r17: https_tls=CRT_BUNDLE verification=ESP_CRT_BUNDLE http_unchanged=YES audio=PCM5101_I2S\n");
    }
}



#include "esp_err.h"
#include "esp_http_client.h"
#include "esp_crt_bundle.h"
#include "mp3dec.h"

extern bool st77916_audio_pcm_init(uint32_t sample_rate, uint16_t bits_per_sample, uint16_t channels);
extern int32_t st77916_audio_pcm_write(const uint8_t *data, uint32_t len, uint32_t timeout_ms);
extern void st77916_audio_pcm_stop(void);

#define RADIO_INPUT_BYTES 65536
#define RADIO_REFILL_CHUNK 2048
#define RADIO_HELIX_OUT_SAMPLES (MAX_NCHAN * MAX_NGRAN * MAX_NSAMP)
#define RADIO_MAX_DECODE_ERRORS 96

enum {
    RADIO_STATUS_IDLE = 0,
    RADIO_STATUS_CONNECTING = 1,
    RADIO_STATUS_BUFFERING = 2,
    RADIO_STATUS_PLAYING = 3,
    RADIO_STATUS_STOPPING = 4,
    RADIO_STATUS_STOPPED = 5,
    RADIO_STATUS_ERROR = 6,
};

static volatile bool s_radio_stop_requested = false;
static volatile uint32_t s_radio_volume_percent = 60;
static volatile uint32_t s_radio_elapsed_seconds = 0;
static volatile uint32_t s_radio_buffered_bytes = 0;
static volatile uint32_t s_radio_status = RADIO_STATUS_IDLE;

void st77916_radio_http_mp3_set_volume(uint32_t volume_percent) {
    s_radio_volume_percent = volume_percent > 100 ? 100 : volume_percent;
}

uint32_t st77916_radio_http_mp3_elapsed_seconds(void) {
    return s_radio_elapsed_seconds;
}

uint32_t st77916_radio_http_mp3_buffered_bytes(void) {
    return s_radio_buffered_bytes;
}

uint32_t st77916_radio_http_mp3_status_code(void) {
    return s_radio_status;
}

void st77916_radio_http_mp3_stop_request(void) {
    s_radio_stop_requested = true;
    s_radio_status = RADIO_STATUS_STOPPING;
    printf("radio-r36: stop_request=DEFERRED_TO_STREAM_THREAD i2s_stop_owner=RADIO_THREAD audio=PCM5101_I2S\n");
}

static void scale_pcm16(short *samples, int sample_count, uint32_t volume_percent) {
    int32_t volume = (int32_t)(volume_percent > 100 ? 100 : volume_percent);
    for (int i = 0; i < sample_count; i++) {
        int32_t scaled = ((int32_t)samples[i] * volume) / 100;
        if (scaled > 32767) {
            scaled = 32767;
        } else if (scaled < -32768) {
            scaled = -32768;
        }
        samples[i] = (short)scaled;
    }
}

static bool compact_input(unsigned char *input, unsigned char **read_ptr, int *bytes_left) {
    if (*read_ptr != input && *bytes_left > 0) {
        memmove(input, *read_ptr, (size_t)*bytes_left);
    }
    *read_ptr = input;
    return true;
}

static bool refill_http(esp_http_client_handle_t client,
                        unsigned char *input,
                        unsigned char **read_ptr,
                        int *bytes_left) {
    compact_input(input, read_ptr, bytes_left);

    while (*bytes_left < (RADIO_INPUT_BYTES - RADIO_REFILL_CHUNK) && !s_radio_stop_requested) {
        int space = RADIO_INPUT_BYTES - *bytes_left;
        if (space <= 0) {
            break;
        }
        int want = space > RADIO_REFILL_CHUNK ? RADIO_REFILL_CHUNK : space;
        int n = esp_http_client_read(client, (char *)(input + *bytes_left), want);
        if (n > 0) {
            *bytes_left += n;
            s_radio_buffered_bytes = (uint32_t)*bytes_left;
            if (*bytes_left >= 4096) {
                return true;
            }
            continue;
        }
        if (n == 0) {
            return *bytes_left > 0;
        }
        return false;
    }

    s_radio_buffered_bytes = (uint32_t)*bytes_left;
    return *bytes_left > 0;
}

int32_t st77916_radio_http_mp3_play(const char *url, const char *station_name, uint32_t volume_percent) {
    if (url == NULL || station_name == NULL) {
        return -10;
    }

    s_radio_stop_requested = false;
    s_radio_elapsed_seconds = 0;
    s_radio_buffered_bytes = 0;
    s_radio_status = RADIO_STATUS_CONNECTING;
    st77916_radio_http_mp3_set_volume(volume_percent);

    printf("radio-r36-r15: action=CONNECT station=%s url=%s format=%s audio=PCM5101_I2S\n", station_name, url, radio_stream_format_label(url));

    esp_http_client_config_t config = {
        .url = url,
        .crt_bundle_attach = esp_crt_bundle_attach,
        .skip_cert_common_name_check = false,
        .timeout_ms = 8000,
        .buffer_size = 2048,
        .buffer_size_tx = 512,
    };

        config.crt_bundle_attach = esp_crt_bundle_attach;
    config.skip_cert_common_name_check = false;
esp_http_client_handle_t client = esp_http_client_init(&config);
    if (client == NULL) {
        s_radio_status = RADIO_STATUS_ERROR;
        printf("radio-r36: status=HTTP_CLIENT_INIT_FAILED station=%s audio=PCM5101_I2S\n", station_name);
        return -11;
    }

    esp_err_t err = esp_http_client_open(client, 0);
    if (err != ESP_OK) {
        s_radio_status = RADIO_STATUS_ERROR;
        printf("radio-r36-r17: status=HTTP_OPEN_FAILED station=%s err=%d https_tls=CRT_BUNDLE note=OPEN_FAILED audio=PCM5101_I2S\n", station_name, (int)err);
        esp_http_client_cleanup(client);
        return -12;
    }

    int content_length = esp_http_client_fetch_headers(client);
    int status_code = esp_http_client_get_status_code(client);
    printf("radio-r36-r15: status=%s station=%s http_status=%d content_length=%d audio=PCM5101_I2S\n",
           strncmp(url, "https://", 8) == 0 ? "HTTPS_CONNECTED" : "HTTP_CONNECTED",
           station_name,
           status_code,
           content_length);

    HMP3Decoder decoder = MP3InitDecoder();
    if (decoder == NULL) {
        s_radio_status = RADIO_STATUS_ERROR;
        esp_http_client_close(client);
        esp_http_client_cleanup(client);
        printf("radio-r36: status=ALLOC_DECODER_FAILED station=%s audio=PCM5101_I2S\n", station_name);
        return -13;
    }

    unsigned char *input = (unsigned char *)malloc(RADIO_INPUT_BYTES);
    short *output = (short *)malloc(sizeof(short) * RADIO_HELIX_OUT_SAMPLES);
    if (input == NULL || output == NULL) {
        s_radio_status = RADIO_STATUS_ERROR;
        if (input != NULL) free(input);
        if (output != NULL) free(output);
        MP3FreeDecoder(decoder);
        esp_http_client_close(client);
        esp_http_client_cleanup(client);
        printf("radio-r36: status=ALLOC_BUFFER_FAILED station=%s input=%u output_samples=%u audio=PCM5101_I2S\n",
               station_name,
               (unsigned)RADIO_INPUT_BYTES,
               (unsigned)RADIO_HELIX_OUT_SAMPLES);
        return -14;
    }

    unsigned char *read_ptr = input;
    int bytes_left = 0;
    bool pcm_started = false;
    bool first_write = false;
    int current_sample_rate = 0;
    int current_channels = 0;
    int decode_errors = 0;
    int frame_count = 0;
    uint64_t decoded_pcm_frames = 0;

    s_radio_status = RADIO_STATUS_BUFFERING;
    printf("radio-r36: status=BUFFERING station=%s buffer_target=%u audio=PCM5101_I2S\n",
           station_name,
           (unsigned)RADIO_INPUT_BYTES);

    while (!s_radio_stop_requested) {
        if (bytes_left < 4096) {
            if (!refill_http(client, input, &read_ptr, &bytes_left)) {
                break;
            }
        }

        int sync_offset = MP3FindSyncWord(read_ptr, bytes_left);
        if (sync_offset < 0) {
            if (bytes_left > 3) {
                memmove(input, read_ptr + bytes_left - 3, 3);
                read_ptr = input;
                bytes_left = 3;
            } else {
                compact_input(input, &read_ptr, &bytes_left);
            }
            if (!refill_http(client, input, &read_ptr, &bytes_left)) {
                break;
            }
            continue;
        }

        read_ptr += sync_offset;
        bytes_left -= sync_offset;

        unsigned char *decode_ptr = read_ptr;
        int decode_left = bytes_left;
        int dec = MP3Decode(decoder, &decode_ptr, &decode_left, output, 0);
        int consumed = bytes_left - decode_left;

        if (consumed > 0) {
            read_ptr = decode_ptr;
            bytes_left = decode_left;
        } else if (bytes_left > 0) {
            read_ptr += 1;
            bytes_left -= 1;
        }
        s_radio_buffered_bytes = (uint32_t)bytes_left;

        if (dec == ERR_MP3_MAINDATA_UNDERFLOW || dec == ERR_MP3_INDATA_UNDERFLOW) {
            if (!refill_http(client, input, &read_ptr, &bytes_left)) {
                break;
            }
            continue;
        }

        if (dec != ERR_MP3_NONE) {
            decode_errors++;
            if (decode_errors > RADIO_MAX_DECODE_ERRORS) {
                printf("radio-r36: status=DECODE_ERROR station=%s err=%d errors=%d audio=PCM5101_I2S\n",
                       station_name,
                       dec,
                       decode_errors);
                break;
            }
            continue;
        }

        MP3FrameInfo info;
        memset(&info, 0, sizeof(info));
        MP3GetLastFrameInfo(decoder, &info);

        if (info.samprate < 8000 || info.samprate > 96000 || info.nChans < 1 || info.nChans > 2 || info.bitsPerSample != 16 || info.outputSamps <= 0) {
            printf("radio-r36: status=UNSUPPORTED_FRAME station=%s sample_rate=%d channels=%d bits=%d output_samps=%d audio=PCM5101_I2S\n",
                   station_name,
                   info.samprate,
                   info.nChans,
                   info.bitsPerSample,
                   info.outputSamps);
            break;
        }

        if (!pcm_started || current_sample_rate != info.samprate || current_channels != info.nChans) {
            if (pcm_started) {
                st77916_audio_pcm_stop();
            }
            if (!st77916_audio_pcm_init((uint32_t)info.samprate, 16, (uint16_t)info.nChans)) {
                printf("radio-r36: status=PCM_INIT_FAILED station=%s sample_rate=%d channels=%d audio=PCM5101_I2S\n",
                       station_name,
                       info.samprate,
                       info.nChans);
                break;
            }
            pcm_started = true;
            current_sample_rate = info.samprate;
            current_channels = info.nChans;
            s_radio_status = RADIO_STATUS_PLAYING;
            printf("radio-r36: status=PLAYING station=%s decoder=HELIX_FIXED_POINT sample_rate=%d channels=%d bitrate=%d audio=PCM5101_I2S\n",
                   station_name,
                   info.samprate,
                   info.nChans,
                   info.bitrate);
        }

        scale_pcm16(output, info.outputSamps, s_radio_volume_percent);
        int32_t written = st77916_audio_pcm_write((const uint8_t *)output, (uint32_t)(info.outputSamps * (int)sizeof(short)), 250);
        if (written <= 0) {
            printf("radio-r36: status=WRITE_FAILED station=%s err=%d audio=PCM5101_I2S\n", station_name, (int)written);
            break;
        }

        if (info.nChans > 0 && info.samprate > 0) {
            decoded_pcm_frames += (uint64_t)(info.outputSamps / info.nChans);
            s_radio_elapsed_seconds = (uint32_t)(decoded_pcm_frames / (uint64_t)info.samprate);
        }

        frame_count++;
        if (!first_write) {
            first_write = true;
            printf("radio-r36: status=FIRST_WRITE_OK station=%s bytes=%d sample_rate=%d channels=%d audio=PCM5101_I2S\n",
                   station_name,
                   (int)written,
                   info.samprate,
                   info.nChans);
        }

        if ((frame_count % 150) == 0) {
            printf("radio-r36: status=PROGRESS station=%s frames=%d elapsed_s=%u buffered=%u volume=%u audio=PCM5101_I2S\n",
                   station_name,
                   frame_count,
                   (unsigned)s_radio_elapsed_seconds,
                   (unsigned)s_radio_buffered_bytes,
                   (unsigned)s_radio_volume_percent);
        }
    }

    if (pcm_started) {
        st77916_audio_pcm_stop();
    }

    free(output);
    free(input);
    MP3FreeDecoder(decoder);
    esp_http_client_close(client);
    esp_http_client_cleanup(client);

    int stopped = s_radio_stop_requested ? 1 : 0;
    s_radio_stop_requested = false;
    s_radio_status = RADIO_STATUS_STOPPED;
    printf("radio-r36: status=%s station=%s frames=%d first_write=%s audio=PCM5101_I2S\n",
           stopped ? "STOPPED" : "ENDED_OR_ERROR",
           station_name,
           frame_count,
           first_write ? "YES" : "NO");

    return stopped ? 1 : 0;
}
